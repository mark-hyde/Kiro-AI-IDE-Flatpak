{
  "app-id": "dev.kiro.KiroIDE",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "kiro",
  "modules": [
    {
      "name": "kiro",
      "buildsystem": "simple",
      "build-commands": [
	  "mkdir kiro-extract",
	  "tar -xzf kiro.tar.gz -C kiro-extract",
	  "mkdir -p /app/Kiro",
	  "cp -r kiro-extract/Kiro/* /app/Kiro/",
	  "mkdir -p /app/bin",
	  "ln -sf /app/Kiro/kiro /app/bin/kiro",
	  "chmod +x /app/Kiro/kiro",
	  "mkdir -p /app/share/applications",
	  "cp dev.kiro.KiroIDE.desktop /app/share/applications/dev.kiro.KiroIDE.desktop",
	  "mkdir -p /app/share/icons/hicolor/256x256/apps",
	  "cp dev.kiro.KiroIDE.png /app/share/icons/hicolor/256x256/apps/dev.kiro.KiroIDE.png"
      ],
      "sources": [
	  {
	    "type": "file",
	    "path": "kiro.tar.gz"
	  },
	  {
	  "type": "file",
	  "path": "dev.kiro.KiroIDE.desktop"
	  },
	  {
	  "type": "file",
	  "path": "dev.kiro.KiroIDE.png"
	  }
	]

    }
  ],
  "desktop-file-name-suffix": "Kiro",
  "finish-args": [
    "--share=network",
    "--filesystem=home",
    "--socket=x11",
    "--socket=wayland"
  ]
}
